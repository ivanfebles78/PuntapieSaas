# Conexión a PostgreSQL (en Railway: referencia a la variable DATABASE_URL del servicio Postgres)
DATABASE_URL=postgres://usuario:clave@localhost:5432/puntapie

# Cuenta de administración que se crea en el primer arranque (si no existe).
# La contraseña inicial va ya hasheada (bcrypt) en src/config.js.
# Para usar otra: ADMIN_PASSWORD_HASH (un hash bcrypt) o ADMIN_INITIAL_PASSWORD (en claro).
ADMIN_EMAIL=
ADMIN_NAME=Iván
ADMIN_PASSWORD_HASH=
ADMIN_INITIAL_PASSWORD=

# URL pública de la app, usada en los enlaces para restablecer la contraseña.
# En Railway, si se deja vacía, se usa RAILWAY_PUBLIC_DOMAIN automáticamente.
APP_URL=

# Envío de correo con Resend (https://resend.com). Sin estas variables el
# enlace para restablecer la contraseña solo se escribe en los logs.
RESEND_API_KEY=
MAIL_FROM=Puntapié <no-responder@zapateriapuntapie.com>
